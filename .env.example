# Variables de entorno
PORT=3000
NODE_ENV=development

# Conexión a Base de Datos (Supabase PostgreSQL o Postgres local)
# Ejemplo Supabase: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consultorio_db?schema=public"

# Clave de SuperAdmin para accesos de configuración técnica
SUPERADMIN_SECRET="superadmin123"

# Google Gemini API Key (opcional en .env, se puede configurar desde el panel SuperAdmin)
GEMINI_API_KEY=""

# URL pública de la app (necesaria para el keep-alive en Render y enlaces mágicos)
# En local: http://localhost:3000 | En Render: https://mi-consultorio.onrender.com
APP_URL="http://localhost:3000"
